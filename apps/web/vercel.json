{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:route*",
      "destination": "/api/handler?route=:route*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "development/phase7-atomic-execution": false,
      "main": false
    }
  }
}
