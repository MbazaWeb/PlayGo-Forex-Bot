# LOCAL Windows machine only; do not commit actual values.
PLAYGO_SYNC_URL=https://YOUR-PLAYGO-DEPLOYMENT.vercel.app
PLAYGO_MT5_SYNC_TOKEN=
PLAYGO_SYNC_INTERVAL=30

# Vercel server-side only (never VITE_ prefixed):
# PLAYGO_MT5_SYNC_TOKEN= (same random 32+ character token)
# MT5_EXPECTED_LOGIN= (numeric MT5 account login)
# MT5_EXPECTED_SERVER=MetaQuotes-Demo
# MT5_OWNER_DERIV_ACCOUNT_ID= (Deriv account ID authorized to view MT5)
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY= (server-side service role key; never publish)
