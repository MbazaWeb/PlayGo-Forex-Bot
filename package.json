{
  "name": "playgo-trading",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "backend/api",
    "frontend"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "server": "node --env-file-if-exists=.env backend/api/src/index.js",
    "build": "npm run build --workspace @playgo/web",
    "start": "node --env-file-if-exists=.env backend/api/src/index.js",
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:execution": "node --test backend/api/test/real-execution.test.js"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "embedded-postgres": "^18.7.0-beta.19",
    "eslint": "^9.15.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2"
  }
}
