{
  "name": "playgo-trading",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace @playgo/web",
    "server": "node --env-file-if-exists=.env apps/api/src/index.js",
    "build": "npm run build --workspace @playgo/web",
    "start": "node --env-file-if-exists=.env apps/api/src/index.js",
    "test": "node --test",
    "recover:demo": "node --env-file-if-exists=.env apps/api/src/recover-demo.js",
    "strategy:demo": "node --env-file-if-exists=.env apps/api/src/strategy-worker.js",
    "verify:postgres": "node scripts/verify-local-postgres.mjs",
    "verify:deriv": "node --env-file-if-exists=.env scripts/verify-deriv-demo.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "embedded-postgres": "^18.7.0-beta.19"
  }
}
