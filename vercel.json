{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "frontend",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/((?!api/).*)",
          "destination": "/index.html"
        }
      ]
    },
    "api": {
      "root": ".",
      "entrypoint": "backend/api/src/vercel-handler.js",
      "devCommand": "node backend/api/src/vercel-dev-server.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "git": {
    "deploymentEnabled": {
      "development/phase7-atomic-execution": false,
      "main": false,
      "fix/demo-controls": false,
      "fix/terminal-layout": false
    }
  }
}
